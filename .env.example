NODE_ENV=production
PORT=3000
APP_VERSION=1.1.1

# Set during the Vercel frontend build to the public backend origin.
# Example: https://api.draftix.tech
VITE_SOCKET_URL=

# Search-engine ownership tokens (optional). When set at build time,
# scripts/generate-seo-pages.mjs injects them as meta tags into every
# prerendered page. Get the Google token from Google Search Console
# ("HTML tag" verification method) and the Bing token from Bing Webmaster
# Tools ("Meta tag" verification). Values are public but account-bound;
# keep them out of the repo.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Supabase frontend connection. These are public browser credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required in production. Comma-separated when serving multiple hostnames.
ALLOWED_ORIGINS=https://draftix.tech,https://www.draftix.tech

# Use 1 when the app is behind one reverse proxy such as Render, Railway, or Caddy.
TRUST_PROXY=1

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_STATS_TOKEN=replace-with-at-least-24-random-characters

TURN_TIMEOUT_MS=30000
RECONNECT_GRACE_MS=60000
MAX_SESSIONS=5000
MAX_CLIENTS_PER_SESSION=32
SESSION_IDLE_MS=7200000
SESSION_GC_INTERVAL_MS=600000
CATALOG_REFRESH_MS=43200000

# Optional link used by /report.
REPORTS_DISCORD_URL=
